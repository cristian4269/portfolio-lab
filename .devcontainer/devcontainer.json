{
  "name": "portfolio-lab",
  // Added by Streamlit Community Cloud at deploy; Python 3.13 and app/requirements.txt (the
  // deploy's own pins, exported from uv.lock) so a Codespace runs the dashboard as deployed.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r app/requirements.txt && echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "server": "streamlit run app/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
